# 运行时数据与本地构建产物
wbgui
/config.json
/testenv/
/shots/
/.chrome-profile/

# 运行时数据目录：含账号凭证、配置备份、面板登录凭据（绝不能入库）
/data/

# 前端依赖与构建产物（构建产物由 Dockerfile 生成，不入库）
web/node_modules/
web/dist/
# dist 下只保留 .gitkeep 占位：只忽略 assets/ 会让误提交的 index.html
# （引用 /assets/<hash>.js 的构建产物）留在库里，导致 go build 出的服务
# 走不到「前端未构建」提示页，浏览器只看到空白页。
internal/webui/dist/*
!internal/webui/dist/.gitkeep

# 编辑器 / 系统
.DS_Store
*.swp
.idea/
.vscode/

# 本地代理工作目录与工具链
.workbuddy-ai/
.playwright-cli/

# 测试临时产物
.chrome-profile/
shot.sh
web/tsconfig.tsbuildinfo
shots/
